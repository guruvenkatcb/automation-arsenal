      "name": "Weather pull"
    },
    {
      "parameters": {
        "jsCode": "// Get the first item from the input data (assuming array structure)\nconst weatherData = $input.all()[0].json;\n\n// Get today's date in YYYY-MM-DD format\nconst today = new Date();\nconst todayDate = today.toISOString().split('T')[0];\n\n// Extract the hourly data\nconst hourlyData = weatherData.hourly;\nconst timeArray = hourlyData.time;\nconst tempArray = hourlyData.temperature_2m;\n\n// Find the start and end indices for today's data\nlet todayStartIndex = -1;\nlet todayEndIndex = -1;\n\nfor (let i = 0; i < timeArray.length; i++) {\n  const datePart = timeArray[i].split('T')[0];\n  \n  if (datePart === todayDate) {\n    if (todayStartIndex === -1) {\n      todayStartIndex = i;\n    }\n    todayEndIndex = i;\n  } else if (todayStartIndex !== -1) {\n    // We've passed today's data, no need to continue\n    break;\n  }\n}\n\n// Check if we found today's data\nif (todayStartIndex === -1) {\n  throw new Error(\"No temperature data found for today\");\n}\n\n// Extract today's temperatures\nconst todayTemps = tempArray.slice(todayStartIndex, todayEndIndex + 1);\n\n// Calculate high and low temperatures\nconst high = Math.max(...todayTemps);\nconst low = Math.min(...todayTemps);\n\n// Return the result in n8n format\nreturn {\n  high: high,\n  low: low,\n  unit: weatherData.hourly_units.temperature_2m,\n  date: todayDate,\n  numReadings: todayTemps.length\n};"
      },
